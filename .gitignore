# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenvs / uv
.venv/
venv/
.uv/

# Test / lint caches
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Model + inference caches (never commit weights)
.cache/
hf-cache/
models/
*.onnx
*.bin
*.safetensors
*.pt
*.ckpt

# Local env + secrets
.env
.env.*
!.env.example
# Cloudflare tunnel credentials. `cloudflared tunnel create` writes a JSON file
# holding the tunnel secret, and deploy/compose.public.example.yml suggests
# mounting it from this directory — so it is one `git add` away from a public
# repo. Anyone holding it can run the tunnel. (2026-08-10 audit, F-7.)
cloudflared-credentials*.json
deploy/cloudflared.yml

# Security audits and their fix records. This repo is public, and an audit
# names what is *not* fixed yet — a roadmap against a live instance. They live
# in the private sibling repo instead; `docs/security.md` says where. The
# public commitments are SECURITY.md and the operational checks in
# docs/deploy-public.md §1 and §7.5, which stay here on purpose.
research/security-audit-*.md
security-audit-*.md
HANDOFF-security-fixes.md

# Bench output (results are committed deliberately, raw runs are not)
bench/runs/
bench/*.json
!bench/scenarios/*.json

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
# impeccable: shared config.json is committed (reviewable suppressions);
# the machine-local cache and local overrides are not.
.impeccable/hook.cache.json
.impeccable/config.local.json
.playwright/
# @playwright/cli writes snapshots, console logs and screenshots here.
.playwright-cli/
# The detector's URL scan does `import('puppeteer')`, which resolves from the
# skill's own directory — so a design agent links the npx-cached copy in beside
# it. Never a real install, never committed.
node_modules/
