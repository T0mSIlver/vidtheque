<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window and the splash are the theme background, light or dark with the system. -->
    <style name="Theme.Vidtheque" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>
    <style name="Theme.Vidtheque.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vidtheque</item>
    </style>
</resources>
