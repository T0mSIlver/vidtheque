<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only (DESIGN.md): the window and the splash are the theme background. -->
    <style name="Theme.Vidtheque" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
    <style name="Theme.Vidtheque.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vidtheque</item>
    </style>
</resources>
