# ===========================================================================
# BOX:      the PUBLIC container (CT 9001)
# GOES TO:  /var/lib/vidtheque/web.env   (mode 0644, owned by vidtheque)
# READ BY:  vidtheque-web.service, via EnvironmentFile=
#
# A SECOND ENV FILE, DELIBERATELY, and it is two lines long. The obvious move
# was to put these in stack.env with everything else — one file, one
# configuration. It would also hand the front-end process OPENROUTER_API_KEY
# and every other secret on the box, readable from /proc/<pid>/environ, for a
# server that needs neither: the same reasoning that keeps `env_file` off the
# `web` and `worker` services under compose (2026-08-10 audit, F-7).
#
# Both keys are documented in deploy/.env.example's `web/` section, which stays
# the document of record. They are commented out there because the compose path
# sets them itself; this box has no compose, so it sets them here.
# ===========================================================================

# Where THIS SERVER makes its own reads for a page — search, videos, meta. It
# is the mcp process on this box, on the loopback port stack.env pins and
# vidtheque-mcp.service guards (VIDTHEQUE_HOST=127.0.0.1, VIDTHEQUE_PORT=8100).
#
# A BROWSER NEVER USES THIS. Browsers reach Python through the edge by path,
# same-origin (docs/design/frontend-migration.md §1a) — the session cookie,
# `/api/ask` and every frame included. This URL is only the front end reading
# for a render, which is why it can be, and should be, plain http on loopback.
# vidtheque-web.service refuses to start if this line is missing or changed.
VIDTHEQUE_API_URL=http://127.0.0.1:8100

# The header those reads carry the visitor's address under. IT MUST EQUAL
# VIDTHEQUE_TRUSTED_IP_HEADER IN stack.env — that is the header the limiter
# buckets on, and if these two disagree every visitor this server reads for
# shares one 30/min search bucket. Two files, one value: install.md §4.3 diffs
# them and the unit guards this side.
VIDTHEQUE_CLIENT_IP_HEADER=CF-Connecting-IP
