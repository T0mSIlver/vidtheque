# ===========================================================================
# BOX:      the SANDBOX container (Tom's current box, hostname `sandbox`) —
#           the one that keeps the GPU and therefore keeps the WORKER
# INSTALLS: BEFORE-SHIP.md Phase 4.1 (the IDLE_UNLOAD_SECONDS line) and
#           Phase 4.2 (the bridge bind) — one edit, done together
# GOES TO:  /home/dev/vidtheque-data/stack.env   (replaces the live file)
# READ BY:  vidtheque-worker.service via EnvironmentFile=, and still by
#           scripts/dev_stack.sh (which sources it with `set -a`)
#
# STAGED, NOT INSTALLED. This is a REWRITE of the live file as it stood at
# 2026-08-11, not a new file: every line the live stack.env carried is here,
# with the changes the cutover needs marked `CHANGED` and everything else
# marked `unchanged`. Diff it against the live file before copying.
#
# THE LIVE FILE'S OPENROUTER KEY IS NOT REPRODUCED HERE, AND MUST NEVER BE.
# See the ask-mode block near the bottom.
#
# Why this box still matters after cutover (topology B, §3.2): the public
# container runs mcp only. Every public search calls THIS box twice at query
# time for its vector legs. A dead worker here leaves the public site HTTP 200,
# green /healthz and every search silently FTS-only, indefinitely (§2.4, review
# finding 4) — which is why the worker gets a systemd unit
# (deploy/staging/vidtheque-worker.service) instead of staying under
# dev_stack.sh's `nohup`.
# ===========================================================================

# ---------------------------------------------------------------------------
# CHANGED (Phase 4.2) — the worker binds the BRIDGE, not loopback
# ---------------------------------------------------------------------------
#
# Topology B's one genuinely new rule. The worker must answer the public
# container over the host bridge, so it cannot stay on 127.0.0.1.
#
# READ THIS BEFORE EDITING:
#
# 1. scripts/dev_stack.sh CANNOT express this and is not being fixed (Tom,
#    2026-08-11). Its `start` passes `VIDTHEQUE_HOST=127.0.0.1` to the worker
#    INLINE, which wins over anything sourced from this file. So after this
#    change `dev_stack.sh start` would bring up a SECOND worker on
#    127.0.0.1:8081 beside the bridge-bound one — two processes, one GPU, and
#    its own `port_answers` guard would not notice, because it probes
#    127.0.0.1. **Do not run `dev_stack.sh start` on this box once
#    vidtheque-worker.service is installed.** install.md §5 repeats this.
#
# 2. Measured on systemd 257 (Debian 13): `EnvironmentFile=` overrides
#    `Environment=` regardless of directive order, so the unit cannot pin this
#    either. This file is the single source of truth and the unit carries an
#    ExecStartPre guard that refuses to start if the value is loopback or
#    0.0.0.0.
#
# 3. NOT 0.0.0.0. The worker answers an unauthenticated OpenAI-compatible API
#    that will happily spend the GPU, and it also accepts transcription
#    uploads, image batches and OCR — the firewall bounds *who*, not *what*
#    (review finding 8, accepted for launch). One address, one allowed source.
VIDTHEQUE_HOST=192.168.1.98
VIDTHEQUE_PORT=8081

# ---------------------------------------------------------------------------
# CHANGED (Phase 1 decision 3) — embedder residency for launch day
# ---------------------------------------------------------------------------
#
# Was 300 (the shipped default). With EMBED_RESIDENT=0 and a 300 s idle unload,
# the common case on a launch link is that most visitors arrive more than five
# minutes after the last one — so the FIRST SEARCH A HUMAN EVER RUNS pays
# 3.5 s of model load plus a 916 ms first call before its vector legs return
# (measured, research/multimodal-embedding-2026-08-09.md).
#
# 3600 keeps the model for an hour of quiet and still frees it overnight. It
# changes no invariant and does not touch the GPU lease bracket, which is why
# it was chosen over EMBED_RESIDENT=1 (that would hold ~4.4 GB standing AND
# never release the lease until shutdown). Phase 6 measures cold-vs-warm once
# each and takes the residency question again with data.
IDLE_UNLOAD_SECONDS=3600

# ---------------------------------------------------------------------------
# CHANGED (Phase 1 decision 7) — the sandbox stays in DEMO mode after cutover
# ---------------------------------------------------------------------------
#
# Was 0, for indexing. It is 1 now because this box is the rollback: if it is
# quietly reverted to indexing it stops being one. It also means the GPU FIFO
# stays free for the public box's query embeddings — a whisperX stage in flight
# makes every visitor's search wait up to 20 s and then return FTS-only, which
# is the worst launch-day failure mode available because it looks like the
# product being bad (§2.2).
#
# Indexing resumes only after the launch, deliberately, with the tunnel stopped
# (Phase 1 decision 8; docs/deploy-public.md §9).
VIDTHEQUE_PUBLIC_READONLY=1

# ===========================================================================
# Everything below is UNCHANGED from the live file unless marked.
# ===========================================================================

# --- unchanged: the GPU and the unified embedder --------------------------
DEVICE=cuda
# Unified embedding (flip 2026-08-09, research/multimodal-embedding addendum):
# one model, one shared slot, both legs. Non-resident so the llama.cpp lease
# can come back between runs — 4B-class resident weights would hold ~4.4 GB.
EMBED_RESIDENT=0
EMBED_BACKEND=qwen3-vl-embedding
IMAGE_EMBED_BACKEND=qwen3-vl-embedding
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
IMAGE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# 0 = the checkpoint's native 2048. It MUST keep matching the corpus's recorded
# config['text_embed.dim'] / config['frame_embed.dim'] or mcp/ disables both
# vector legs rather than mix widths — and the public box is now the only box
# with that corpus.
EMBED_DIM=0

# --- unchanged, and preserved deliberately: the GPU lease hooks -----------
#
# Both were EMPTY in the live stack.env on 2026-08-11 and they stay empty.
# Recording that as a decision rather than an omission, because §2.3 leans on
# it: nothing is currently managing the llama.cpp VRAM lease on this box, so
# the 8.2 GB llama.cpp holds and the ~4.4 GB the embedder wants are reconciled
# by hand, not by these hooks. GPU_ACQUIRE_CMD failing would 503 an embedding
# request, i.e. a visitor's vector leg — so this is not the morning to arm them.
# deploy/.env.example's "GPU lease hooks" block is the full contract.
GPU_ACQUIRE_CMD=
GPU_RELEASE_CMD=

# --- unchanged: dev_stack.sh's own port variables -------------------------
#
# CAVEAT for the Phase 4.1 key-set diff: these two are read by
# scripts/dev_stack.sh and have NO entry in deploy/.env.example. They will show
# up as "in stack.env, not in .env.example" on this box only, and they are not
# something this staging work introduced — reported to the orchestrator on
# 2026-08-11 as a pre-existing document-of-record gap. Do not delete them:
# dev_stack.sh still starts the sandbox mcp for the rollback lever below.
VIDTHEQUE_WORKER_PORT=8081
VIDTHEQUE_MCP_PORT=8100

# --- unchanged: auth on this box -----------------------------------------
VIDTHEQUE_AUTH=none

# --- unchanged: GPU whisperX is the point of this box ---------------------
VIDTHEQUE_STT_POLICY=prefer_whisperx

# --- unchanged: yt-dlp politeness and the circuit breaker -----------------
# 2026-08-10 night: reversed the 05:10 "maximum politeness" escalation per
# research/ytdlp-usage-audit-2026-08-10.md — the waves are IP blocks, which
# sleeps can't prevent; official preset spacing + a circuit breaker that
# actually outlasts a 60-90 min wave.
# Inert while VIDTHEQUE_PUBLIC_READONLY=1: kept so that resuming indexing after
# the launch is one flag, not an archaeology exercise.
VIDTHEQUE_YTDLP_SLEEP_REQUESTS=0.75
VIDTHEQUE_YTDLP_SLEEP_INTERVAL=10
VIDTHEQUE_YTDLP_MAX_SLEEP_INTERVAL=20
VIDTHEQUE_YTDLP_BETWEEN_VIDEOS_S=30
VIDTHEQUE_YTDLP_EXTRACTOR_RETRIES=3
VIDTHEQUE_RATE_LIMIT_BACKOFF_S=5400

# --- unchanged ------------------------------------------------------------
# Bench-validated 2026-08-09 (research/pipeline-perf §9): byte-identical output,
# 12/12 configs.
VIDTHEQUE_KEYFRAME_EXTRACT_WORKERS=4

# ---------------------------------------------------------------------------
# CHANGED: ask mode off on this box
# ---------------------------------------------------------------------------
#
# The live file carried the OpenRouter key inline. It is NOT reproduced here —
# this file lives in a public repo. Left empty on purpose: after cutover this
# box is the rollback, not the demo, and an empty key means /api/meta reports
# ask_enabled: false and the page hides the toggle rather than offering a
# button that 503s.
#
# The launch key is the one pasted into the PUBLIC box's stack.env. If the
# rollback lever below is ever pulled AND ask mode is wanted on the sandbox,
# paste the same capped key here then — not now, and never into the repo.
#
# Rotation order if it ever leaks: revoke at OpenRouter FIRST, change the
# config second; the running process holds it in memory until restart.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# ROLLBACK LEVER 2 — "abandon the container", pre-staged and NOT armed
# ---------------------------------------------------------------------------
#
# BEFORE-SHIP.md's rollback card step 2 says re-point the tunnel's ingress at
# this box. The runbook is emphatic that this is NOT one line (§8.5, review
# finding 13) — four things must be true and none is true by default:
#
#   1. the sandbox mcp is RUNNING            (Phase 3.2 stopped it)
#   2. it is bound to the BRIDGE, not loopback
#      -> dev_stack.sh pins VIDTHEQUE_HOST=127.0.0.1 inline and is not being
#         fixed, so this needs the mcp started by hand:
#         VIDTHEQUE_HOST=192.168.1.98 VIDTHEQUE_PORT=8100 \
#           VIDTHEQUE_DATA_DIR=/home/dev/vidtheque-data \
#           WORKER_URL=http://127.0.0.1:8081 \
#           /home/dev/work/vidtheque/.venv/bin/python -m vidtheque_mcp
#   3. the firewall allows 8100 from the public container (Phase 4.2 opens
#      only 8081)
#   4. this box is in demo mode — it is, see VIDTHEQUE_PUBLIC_READONLY above
#
# And two more, or the abandoned-to box serves a broken product: the two
# hostname variables below. They are COMMENTED because setting them now would
# break every local check on this box (thumbnails would be built against
# https://vidtheque.dev while nothing serves that name here yet, and the local
# /api/meta would advertise the wrong mcp_url).
#
# Uncomment BOTH, then restart the sandbox mcp, only when arming the lever —
# and test the repoint before the URL is shared, because an untested fallback
# is not a fallback.
#
# PUBLIC_URL=https://vidtheque.dev
# VIDTHEQUE_PUBLIC_HOSTNAME=vidtheque.dev
