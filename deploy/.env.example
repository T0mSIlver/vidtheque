# vidtheque configuration — copy to .env and edit.
#
# Worker settings accept two spellings: the bare name shown here and a
# VIDTHEQUE_-prefixed one (VIDTHEQUE_STT_BACKEND). If both are set, the
# prefixed one wins. Compose passes the bare names through.

# ---------------------------------------------------------------------------
# Ports and URLs
# ---------------------------------------------------------------------------

# Host port for the MCP server.
MCP_PORT=8080
# Host port for the inference worker.
WORKER_PORT=8081
# Where the MCP server reaches the worker. Point this at a hosted
# OpenAI-compatible endpoint if you have no GPU, and delete the worker service.
WORKER_URL=http://worker:8081
# Public origin the MCP server advertises (OAuth metadata, frame URLs).
PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Backend selection — the experimentation surface. One class + one registry
# entry adds a value here; see worker/src/vidtheque_worker/backends/registry.py.
# ---------------------------------------------------------------------------

# Speech-to-text. Options: whisperx
STT_BACKEND=whisperx
# Text embeddings — transcripts, metadata, OCR text. Options: qwen3-embedding,
# bge-m3. Switching this changes the vector space, so it is a re-embed of the
# whole corpus, not a restart. Set EMBED_MODEL to match.
EMBED_BACKEND=qwen3-embedding
# Frame embeddings — keyframes. A separate model and a separate vector space
# from EMBED_BACKEND; the two are never comparable. Options: siglip2
IMAGE_EMBED_BACKEND=siglip2
# On-screen text. Options: rapidocr
OCR_BACKEND=rapidocr

# Model identifiers, interpreted by the selected backend.
STT_MODEL=large-v3
# 1024 dims. With EMBED_BACKEND=bge-m3, use BAAI/bge-m3 (also 1024).
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# 1152 dims. The `-base-` variant is the only other NaFlex checkpoint that
# exists (768 dims); the `-large-`/`-giant-` naflex ids in the HF blog do not.
IMAGE_EMBED_MODEL=google/siglip2-so400m-patch16-naflex
OCR_MODEL=rapidocr-default

# Instruction prefix applied to /v1/embeddings requests with
# input_type=query, and to nothing else. Empty means "use whatever prefix the
# checkpoint ships", which is what you want unless you are reproducing an index
# built elsewhere. It belongs here rather than in calling code because index
# and query must agree — disagree and recall drops with no error anywhere.
EMBED_QUERY_PROMPT=

# Default NaFlex patch budget for /v1/embeddings/image; a request can override
# it per call. This is the frame embedder's resolution knob: higher reads small
# on-screen text better and costs proportionally more. The model was trained on
# 128/256/576/784/1024 — stay on that ladder. 1024 is ~4x the work of 256.
IMAGE_EMBED_MAX_PATCHES=256

# ---------------------------------------------------------------------------
# Device
# ---------------------------------------------------------------------------

# auto | cuda | cpu. auto uses CUDA when torch reports it available.
DEVICE=auto
# ctranslate2 compute type. auto = float16 on CUDA, int8 on CPU.
COMPUTE_TYPE=auto
# whisperX batch size. Lower it if you see OOM on a smaller card.
STT_BATCH_SIZE=16
# Word-level forced alignment. 0 gives segment timestamps only: faster, but
# deep links land less precisely. A request can override per call with
# timestamp_granularities[].
STT_ALIGN=1
# NVML device index used for VRAM accounting.
GPU_INDEX=0
# ONNX Runtime intra-op threads for OCR. OCR runs on CPU by design (the CUDA
# path for PP-OCR is not worth it), and ORT left to itself reads the *host*
# core count rather than the container's limit and oversubscribes. Set this to
# the cores you actually gave the worker; past ~4 it stops helping on these
# small graphs, so scale by running more frames in parallel instead.
OCR_THREADS=4

# ---------------------------------------------------------------------------
# Lifecycle — how the worker shares one GPU
# ---------------------------------------------------------------------------

# Unload a model after this many idle seconds. 0 disables idle unloading
# (models stay resident until evicted for VRAM or the process exits).
IDLE_UNLOAD_SECONDS=300

# 1 keeps the *text* embedding model loaded permanently and exempt from
# eviction. Costs ~1.8 GB of VRAM with the default Qwen3-Embedding-0.6B
# (~2.6 GB with bge-m3); worth it if query-time embedding latency matters to
# you, leave it 0 on a card you share with something else. The frame embedder
# is never resident — it is an indexing cost, not a query cost, and at ~5 GB it
# is the largest model here.
EMBED_RESIDENT=0

# Free VRAM required on top of a backend's own estimate before a load is
# allowed. Raise it if you see allocator failures despite the check passing.
VRAM_HEADROOM_MB=512

# ---------------------------------------------------------------------------
# GPU lease hooks
#
# GPU_ACQUIRE_CMD runs once, before the *first* model load; GPU_RELEASE_CMD
# runs once, after the *last* unload. They exist so a box that also serves
# llama.cpp (or anything else holding VRAM) can hand the card over for a burst
# of indexing and get it back afterwards, without that policy living in the
# worker's code.
#
# Both run as shell commands *inside the worker container*, so they must be
# able to reach whatever they control from there — an HTTP endpoint on the host
# is usually simpler than trying to reach systemd across the boundary.
#
# Failure semantics: a failing acquire hook aborts the load and the request
# gets 503 (better than OOM-ing a neighbour). A failing release hook is logged
# and ignored — it must never fail a user's request.
#
# Examples:
#   GPU_ACQUIRE_CMD=curl -fsS -XPOST http://host.docker.internal:9000/llama/stop
#   GPU_RELEASE_CMD=curl -fsS -XPOST http://host.docker.internal:9000/llama/start
GPU_ACQUIRE_CMD=
GPU_RELEASE_CMD=
# Seconds before a hook is killed and treated as failed.
GPU_HOOK_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# debug | info | warning | error
LOG_LEVEL=info
# Where model weights are cached inside the worker container. The compose file
# mounts a named volume here; several GB, worth keeping across rebuilds.
HF_HOME=/hf-cache

# ---------------------------------------------------------------------------
# Cloudflare tunnel (compose profile: tunnel)
# ---------------------------------------------------------------------------

# Token from a Cloudflare Zero Trust "remotely-managed" tunnel. Route your
# hostname to http://mcp:8080 in the Cloudflare dashboard.
# Required only when running `docker compose --profile tunnel up`.
TUNNEL_TOKEN=
