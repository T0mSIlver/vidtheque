# vidtheque configuration — copy to .env and edit.
#
# Worker settings accept two spellings: the bare name shown here and a
# VIDTHEQUE_-prefixed one (VIDTHEQUE_STT_BACKEND). If both are set, the
# prefixed one wins. Compose passes the bare names through.

# ---------------------------------------------------------------------------
# Ports and URLs
# ---------------------------------------------------------------------------

# Host port for the MCP server.
MCP_PORT=8080
# Host port for the inference worker.
WORKER_PORT=8081
# Where the MCP server reaches the worker. Point this at a hosted
# OpenAI-compatible endpoint if you have no GPU, and delete the worker service.
WORKER_URL=http://worker:8081
# Public origin the MCP server advertises (OAuth metadata, frame URLs). It must
# byte-match what you type into your MCP client, path included.
#
# BEHIND A TUNNEL OR PROXY this must be the PUBLIC https:// origin, even though
# the proxy's hop to this server is plain http on loopback — it describes what
# the world sees, not what the socket does. Every absolute URL is built from it
# and none is derived from the request, so leaving it at localhost is silent
# and expensive: the demo page's thumbnails all 404 (they are absolute by
# contract), and /api/meta hands every visitor an mcp_url pointing at their own
# laptop. It is a different variable from VIDTHEQUE_PUBLIC_HOSTNAME below, and
# you need both. docs/deploy-public.md §3 is the full mapping.
PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Backend selection — the experimentation surface. One class + one registry
# entry adds a value here; see worker/src/vidtheque_worker/backends/registry.py.
# ---------------------------------------------------------------------------

# Speech-to-text. Options: whisperx
STT_BACKEND=whisperx
#
# THE TWO EMBEDDING BACKENDS SHIP AS ONE MODEL.
#
# `qwen3-vl-embedding` answers both the text leg and the frame leg from one
# checkpoint, and when EMBED_BACKEND, IMAGE_EMBED_BACKEND *and* the two model
# ids all agree, the worker loads it ONCE into one shared lifecycle slot: one
# VRAM charge, one eviction clock, one GPU-lease bracket. Point them at
# different backends and you get two models in two slots — still supported,
# still correct, and two loads on a cold `content_type=all` search.
#
# Switching either of these changes the vector space, so it is a re-embed of
# the whole corpus, not a restart. Migrate the database first, then restart the
# worker: the drift check disables both vector legs the moment the worker
# reports a model the corpus does not expect, and the embed stages skip
# themselves while the legs are disabled — so worker-first latches the re-embed
# off (research/multimodal-embedding-2026-08-09.md §5.4).
#
# Text embeddings — transcripts, metadata, OCR text.
# Options: qwen3-vl-embedding, qwen3-embedding, bge-m3
EMBED_BACKEND=qwen3-vl-embedding
# Frame embeddings — keyframes, and the text queries that search them
# (/v1/embeddings/frame-query). Options: qwen3-vl-embedding, siglip2
IMAGE_EMBED_BACKEND=qwen3-vl-embedding
# On-screen text. Options: rapidocr
OCR_BACKEND=rapidocr

# Model identifiers, interpreted by the selected backend.
STT_MODEL=large-v3
# 2048 dims, Apache-2.0, ~4.4 GB of bf16 weights. Both legs, one space.
# EMBED_MODEL and IMAGE_EMBED_MODEL must be byte-identical for the shared slot
# to engage — a difference is read as two checkpoints and loads two.
#   With EMBED_BACKEND=qwen3-embedding, use Qwen/Qwen3-Embedding-0.6B (1024).
#   With EMBED_BACKEND=bge-m3,          use BAAI/bge-m3 (also 1024).
# Either of those needs config['text_embed.dim'] and the vec_chunks DDL moved
# back to 1024 — see docs/design/index-schema.md §3.1.
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# With IMAGE_EMBED_BACKEND=siglip2, use google/siglip2-so400m-patch16-naflex
# (1152 dims, both towers, text tower trained to 64 tokens).
IMAGE_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
OCR_MODEL=rapidocr-default

# MRL truncation width for the unified embedder. 0 = the checkpoint's native
# 2048, which is the shipped decision: truncation is the fallback if query
# latency or storage argues for it, not the starting point. Qwen publish a
# sweep for this model (1024 -> 512 costs 1.4% of retrieval), so narrowing
# later is this line plus a ~12-minute re-embed. It MUST equal
# config['text_embed.dim'] and config['frame_embed.dim'] in the corpus, or the
# server refuses to index and answers FTS-only.
EMBED_DIM=0

# Instructions. An instruction-aware embedder gives the same text different
# vectors under different instructions, so these are part of the vector space,
# not decoration. Empty means "use the backend's documented default", which is
# what you want unless you are reproducing an index built elsewhere.
#
# They belong here rather than in calling code because index and query must
# agree — disagree and recall drops with no error anywhere. The corpus records
# what indexing assumed in config['text_embed.query_prefix'] and
# config['frame_embed.query_prefix']; the worker echoes what it actually
# applied on every embeddings response and under `instructions` on GET /status,
# so `curl $WORKER_URL/status` is the whole reconciliation. (That record was
# wrong from the first commit and nobody noticed — it said `query: ` against a
# model that applies `Instruct: …`.)
#
# Applied to /v1/embeddings with input_type=query, and to nothing else.
# Default: "Given a search query, retrieve the transcript passage that answers it"
EMBED_QUERY_PROMPT=
# Applied to /v1/embeddings/frame-query. A DIFFERENT instruction on purpose:
# one model, one space, two retrieval tasks. Ignored by siglip2, whose text
# tower takes no instruction.
# Default: "Given a search query, retrieve the video frame that matches it"
FRAME_QUERY_PROMPT=

# Items per forward pass inside the worker. `mcp/` batches per *request*
# (VIDTHEQUE_EMBED_BATCH / VIDTHEQUE_FRAME_EMBED_BATCH); these bound what one
# request costs in VRAM. The image batch is lower because a 1280x720 keyframe
# is ~1,176 visual tokens against a transcript chunk's few hundred, and
# activation is most of the embedder's VRAM estimate.
EMBED_BATCH_SIZE=16
IMAGE_EMBED_BATCH_SIZE=8

# SIGLIP 2 ONLY. The unified embedder ignores it: it takes the frame at its
# stored resolution (1280x720 -> ~1,176 visual tokens), which the paper's own
# sweep puts at the knee of its scaling curve, so there is nothing to tune.
#
# Default NaFlex patch budget for /v1/embeddings/image (the image tower only —
# text queries have no such knob); a request can override
# it per call. This is the frame embedder's resolution knob: higher reads small
# on-screen text better and costs proportionally more. The model was trained on
# 128/256/576/784/1024 — stay on that ladder. 1024 is ~4x the work of 256.
# Raising it also raises the frame embedder's admission estimate (the measured
# 3200 MB at 256, with the activation part of it scaled by the budget), so the
# worker will evict a neighbour or refuse a load rather than discover the new
# ceiling as an OOM mid-batch. Below 256 the estimate stays at 3200: scaling is
# upward only, because nothing has been measured at the bottom of the ladder.
IMAGE_EMBED_MAX_PATCHES=256

# ---------------------------------------------------------------------------
# Device
# ---------------------------------------------------------------------------

# auto | cuda | cpu. auto uses CUDA when torch reports it available.
DEVICE=auto
# ctranslate2 compute type. auto = float16 on CUDA, int8 on CPU.
COMPUTE_TYPE=auto
# whisperX batch size. Lower it if you see OOM on a smaller card: measured peak
# on a 3090 is 7941 MB at 16 and 5352 MB at 4, against 4993 MB just sitting
# there. The admission estimate is the measured 8000 MB at 16 and scales
# *upward* from there (~216 MB per unit of batch, the slope through those two
# points — an extrapolation, not a measurement). Below 16 it stays at 8000, so
# lowering the batch still makes the worker more conservative, never less.
STT_BATCH_SIZE=16
# Word-level forced alignment. 0 gives segment timestamps only: faster, but
# deep links land less precisely. A request can override per call with
# timestamp_granularities[].
STT_ALIGN=1
# NVML device index used for VRAM accounting.
GPU_INDEX=0
# ONNX Runtime intra-op threads for OCR. OCR runs on CPU by design (the CUDA
# path for PP-OCR is not worth it), and ORT left to itself reads the *host*
# core count rather than the container's limit and oversubscribes. Set this to
# the cores you actually gave the worker; past ~4 it stops helping on these
# small graphs, so scale by running more frames in parallel instead.
OCR_THREADS=4

# ---------------------------------------------------------------------------
# Lifecycle — how the worker shares one GPU
# ---------------------------------------------------------------------------

# Unload a model after this many idle seconds. 0 disables idle unloading
# (models stay resident until evicted for VRAM or the process exits).
IDLE_UNLOAD_SECONDS=300

# 1 keeps the *text* embedding model loaded permanently and exempt from
# eviction. It names the `embed` slot — which, with the shipped unified
# embedder, is also the frame slot: one set of weights cannot be pinned for one
# leg and evictable for the other, so there is one decision here instead of two.
#
# Leave it off, and more firmly than before. A resident model holds VRAM for the
# life of the process but never holds the GPU lease, and the lease is released
# only when nothing that took it is loaded — so with a resident embedder
# GPU_RELEASE_CMD fires at shutdown and never before. Measured
# (research/gpu-validation-2026-08-08.md §5.3): llama.cpp is stopped at the
# first embedding request and never restarted. That cost 1.5 GB standing with
# the old Qwen3-Embedding-0.6B; with the unified 2B it costs ~4.4 GB standing
# and the co-tenant still never comes back.
#
# What it buys, if you turn it on anyway: the reload the first query after an
# idle gap would pay. Going unified already collects most of that win — a cold
# `content_type=all` search used to load two models (3.7 s + 5.8 s, possibly
# with an eviction between them) and now loads one.
EMBED_RESIDENT=0

# Free VRAM required on top of a backend's own estimate before a load is
# allowed. Raise it if you see allocator failures despite the check passing.
VRAM_HEADROOM_MB=512

# How long shutdown waits for a job that is already *inside* a model before it
# frees the weights anyway. Inference runs in a worker thread and a thread
# cannot be cancelled, so the choice on SIGTERM is: wait, or call the model's
# destructor under a thread that is still using it. Everything merely queued is
# failed immediately with a 503 either way — this timer only covers the one job
# on the GPU. Size it for the longest job you are willing to hold a restart
# open for (a long transcription can exceed it, and then the unload proceeds
# regardless). 0 disables the wait.
SHUTDOWN_GRACE_SECONDS=30

# ---------------------------------------------------------------------------
# GPU lease hooks
#
# GPU_ACQUIRE_CMD runs once, before the first load of a model that competes for
# the card; GPU_RELEASE_CMD runs once, when no such model is left loaded. They
# exist so a box that also serves llama.cpp (or anything else holding VRAM) can
# hand the card over for a burst of indexing and get it back afterwards,
# without that policy living in the worker's code.
#
# What the bracket covers — "competes for the card" means a GPU model that can
# be unloaded again:
#   * OCR runs on CPU (0 MB estimate) and is outside the lease entirely: an
#     OCR-only request never stops your co-tenant, because it was never going
#     to contend with it.
#   * A resident model (EMBED_RESIDENT=1) is outside it too. It holds its
#     1.5 GB for the life of the process, so bracketing it would acquire the
#     lease at the first embedding request and never release it — the co-tenant
#     would be stopped forever. Resident models hold VRAM, not the lease; size
#     your co-tenant to run alongside that 1.5 GB rather than expecting it back.
#   * So: acquire fires before the first whisperX / frame-embedder / evictable
#     text-embedder load, and release fires once the last of them is unloaded
#     (idle TTL, eviction, a failed job, or shutdown).
#
# Both run as shell commands *inside the worker container*, so they must be
# able to reach whatever they control from there — an HTTP endpoint on the host
# is usually simpler than trying to reach systemd across the boundary.
#
# Failure semantics: a failing acquire hook aborts the load and the request
# gets 503 (better than OOM-ing a neighbour). A failing release hook is logged
# and ignored — it must never fail a user's request.
#
# Examples:
#   GPU_ACQUIRE_CMD=curl -fsS -XPOST http://host.docker.internal:9000/llama/stop
#   GPU_RELEASE_CMD=curl -fsS -XPOST http://host.docker.internal:9000/llama/start
GPU_ACQUIRE_CMD=
GPU_RELEASE_CMD=
# Seconds before a hook is killed and treated as failed.
GPU_HOOK_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# debug | info | warning | error
LOG_LEVEL=info
# Where model weights are cached inside the worker container. The compose file
# mounts a named volume here; several GB, worth keeping across rebuilds. The
# worker exports this into its own environment at startup, so setting it in
# this file works for a bare `uv run` too — transformers, huggingface_hub and
# ctranslate2 all read it from the environment rather than from any config.
HF_HOME=/hf-cache

# ---------------------------------------------------------------------------
# Cloudflare tunnel (compose profile: tunnel)
#
# Going public is a runbook, not a variable: docs/deploy-public.md. Read it
# before setting anything here — it carries the pre-flight checklist, the
# required security audit, the exact PUBLIC_URL / VIDTHEQUE_PUBLIC_HOSTNAME
# mapping, and the smoke tests that catch a tunnel that only *looks* right.
#
# READ THIS IF YOU DEPLOY WITH COMPOSE. This file is compose's *interpolation*
# source; it is not the container's environment. docker-compose.yml hands the
# `mcp` service four variables by name and nothing else, so every setting below
# this line — the readonly flag, the auth mode, the hostname allowlist, the
# rate limits, the OpenRouter key — sits here being read by nobody, and the
# server comes up in full read-write mode on a public hostname. Overlay
# deploy/compose.public.example.yml (env_file + loopback binds) or use
# scripts/dev_stack.sh, which sources its stack.env with `set -a`.
# ---------------------------------------------------------------------------

# Token from a Cloudflare Zero Trust "remotely-managed" tunnel. Route your
# hostname to http://mcp:8080 in the Cloudflare dashboard. Anyone holding this
# token can run the tunnel — treat it as a private key, and rotate it if it
# ever lands somewhere it should not have.
# Required only when running `docker compose --profile tunnel up`.
#
# For a LOCALLY-managed tunnel instead — ingress in the repo rather than in a
# dashboard, which is what the runbook recommends — leave this empty and use
# deploy/cloudflared.example.yml.
TUNNEL_TOKEN=

# ===========================================================================
# MCP server (mcp/) — added with the vidtheque-mcp implementation.
#
# CLAUDE.md: this file is the document of record. An env var without an entry
# here is a bug.
# ===========================================================================

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Everything the MCP server owns lives under one root: vidtheque.db (+ -wal,
# -shm), keyframes/, derived/, audio/, media/, tmp/, exports/, backups/.
# The compose file mounts a volume here.
VIDTHEQUE_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Authentication — one branch, chosen at boot.
#
#   none   no OAuth metadata, no 401, frames served unsigned.
#          For localhost or a trusted LAN:
#          claude mcp add --transport http vidtheque http://pi.local:8080/mcp
#   token  a static bearer. For a tunnel without OAuth: Claude Code --header,
#          Cursor, or claude.ai's static_headers connector (beta).
#   oauth  vidtheque is its own OAuth authorization server (CIMD, with DCR
#          retained). The documented default for public exposure.
# ---------------------------------------------------------------------------

VIDTHEQUE_AUTH=none

# Required when VIDTHEQUE_AUTH=token. The value is sent verbatim by the client,
# so the client-side setting is "Authorization: Bearer <this>".
VIDTHEQUE_TOKEN=

# Required when VIDTHEQUE_AUTH=oauth: the owner's password for the login page.
VIDTHEQUE_PASSWORD=

# Signing key for access tokens and frame URLs (separate keys are derived from
# it with distinct salts). Leave empty and one is generated into
# $VIDTHEQUE_DATA_DIR/secret.key on first boot, so a compose file needs no
# secret management.
VIDTHEQUE_SECRET=

# Comma-separated hostnames the server answers on, beyond localhost. THIS IS
# THE TUNNEL FOOTGUN: the MCP transport arms DNS-rebinding protection with a
# localhost-only allowlist, so behind a real hostname every request is
# 421 Misdirected Request until the hostname is named here. With
# VIDTHEQUE_AUTH=oauth, boot fails with a clear message rather than serving
# 421s to every request.
VIDTHEQUE_PUBLIC_HOSTNAME=

# Access-token lifetime in seconds. Short is fine: refresh tokens rotate, and
# a stateless JWT cannot be withdrawn before it expires.
VIDTHEQUE_ACCESS_TOKEN_TTL=3600
# Refresh-token lifetime in seconds. Default 30 days.
VIDTHEQUE_REFRESH_TOKEN_TTL=2592000

# ---------------------------------------------------------------------------
# Frame URLs
# ---------------------------------------------------------------------------

# get-frames returns HMAC-signed URLs by default, because a browser rendering
# the image attaches no Authorization header. These are capability URLs: anyone
# holding one reads that frame until it expires. Default 24h. The /frames route
# also accepts a bearer token and the login-session cookie.
VIDTHEQUE_FRAME_URL_TTL=86400

# Inline base64 images (get-frames return="image") are capped independently of
# `limit`, because on some clients an inline image costs 10-20x its nominal
# token price. Extras downgrade to URLs rather than failing.
VIDTHEQUE_INLINE_FRAME_MAX=4
VIDTHEQUE_INLINE_FRAME_BYTES=6291456

# `/frames/<id>.jpg?w=&q=` resamples into $VIDTHEQUE_DATA/derived/ and serves
# from there. Byte-capped LRU, not an entry count — a 64 px variant and a
# 1280 px one differ by 20x. `derived/` is disposable: deleting it costs one
# resample per variant and nothing else (index-schema §6).
VIDTHEQUE_DERIVED_CACHE_MB=256

# Cache-Control max-age on a served frame, in seconds. The bytes for a given
# (frame_id, w, q) are written once at index time, so this is much longer than
# the 300 s the static assets use — a day rather than a year because
# re-indexing a video reuses its ordinals, so the URL can outlive its pixels.
# A signed URL's response is additionally capped at whatever is left of its own
# signature, and bearer/cookie responses are marked `private`.
VIDTHEQUE_FRAME_CACHE_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Token discipline and query budgets
# ---------------------------------------------------------------------------

# Whole-response character cap. Items are dropped from the tail with a line
# saying how many, and how to ask for less.
VIDTHEQUE_RESPONSE_MAX_CHARS=60000
# Per-leg FTS/vector candidate window. Bounded independently of `limit`.
VIDTHEQUE_CANDIDATE_CAP=5000
# Relevance floors for the two nearest-neighbour legs, as COSINE DISTANCE
# ceilings (0 = identical, 2 = opposite): a hit further than this is dropped
# before fusion. Nearest-neighbour search always returns its k nearest, so
# without a ceiling a gibberish query ranks the whole corpus. Measured on a
# real corpus the junk and real distance ranges overlap almost completely, so
# these defaults sit above the whole observed real range and only trim an
# absurd tail — the gate that actually rejects nonsense is whether any query
# term occurs in the corpus at all. Lower them only with measurements in hand.
#
# UNCALIBRATED AS SHIPPED. The measured numbers — 0.72 text, 0.96 frame — were
# taken in the SigLIP 2 (1152-d) and Qwen3-Embedding-0.6B (1024-d) spaces, and
# an absolute cosine distance does not survive a change of embedder: a model
# that packs its corpus at a different radius turns a ceiling that sat safely
# above one real range into one that cuts through another. So the unified
# default is effectively open (1.0 = drop only anti-correlated hits) until the
# GPU bench re-measures both on this corpus.
#
#   Running the old pair? Set VIDTHEQUE_VEC_MAX_DISTANCE=0.72 (Qwen3-0.6B) and
#   VIDTHEQUE_FRAME_MAX_DISTANCE=0.96 (SigLIP 2).
VIDTHEQUE_VEC_MAX_DISTANCE=1.0
VIDTHEQUE_FRAME_MAX_DISTANCE=1.0
# Seconds subtracted from a hit's start in the youtu.be deep link, so the
# sentence is not already half-spoken when playback starts.
VIDTHEQUE_DEEPLINK_LEAD=2
# Query budget in seconds. Enforced with a real SQLite progress handler plus
# interrupt(), so a dropped future stops actual work instead of leaking a
# connection until the pool drains.
VIDTHEQUE_QUERY_TIMEOUT_S=30
# Admission control: a third concurrent uncached search gets an immediate
# E_BUSY, not a queue slot. Queueing turns a slow query into a slow everything.
VIDTHEQUE_MAX_CONCURRENT_SEARCHES=2
# Read-only connection pool size. There is always exactly one writer.
VIDTHEQUE_READ_POOL_SIZE=4

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Timezone reported in the vidtheque://context resource, so the model never
# does date arithmetic.
VIDTHEQUE_TIMEZONE=UTC
# Bind address and port inside the container.
VIDTHEQUE_HOST=0.0.0.0
VIDTHEQUE_PORT=8080

# ---------------------------------------------------------------------------
# Indexing pipeline — retention
#
# The corpus is the index; the source mp4 is scaffolding. At 500 videos that is
# ~6 GB kept versus ~130 GB kept (index-schema §6.1), which is the whole
# argument. Deletion happens only after the last stage of a video reports done,
# so a failure never destroys the input to a retry.
# ---------------------------------------------------------------------------

# none | audio | originals.
#   audio      (default) keep the extracted audio, delete the video. Re-running
#              STT with a better model then needs no re-download, and still
#              works for videos since taken down — the best value per byte here.
#   none       keep neither; every reindex re-downloads.
#   originals  keep the mp4 too. ~20x the disk, and the only part of this
#              pipeline that looks like archiving rather than personal indexing.
VIDTHEQUE_KEEP_SOURCE=audio

# 1 stores per-cue word timings as JSON (~10% of the database, measured at
# 41 MB per 500 videos). 0 writes NULL and costs you word-accurate deep links.
VIDTHEQUE_KEEP_WORD_TIMINGS=1

# opus | wav | flac. What the extracted audio is stored as. opus at 24 kbps
# mono is what the disk budget above is sized on; the worker re-decodes
# whatever it is handed, so this is a retention choice, not a quality one. wav
# is 16 kHz mono PCM — whisper-native, and ~10x the size.
VIDTHEQUE_AUDIO_CODEC=opus

# ---------------------------------------------------------------------------
# Indexing pipeline — sources
# ---------------------------------------------------------------------------

# Height cap for the video downloaded for frame extraction. 1080 is deliberate:
# the frame *embedder* would be happy with 480p, but the OCR leg exists to read
# code and terminal text in screencasts, and 1080p content downscaled to 720p
# puts a 14 px editor font under 10 px, where PP-OCR recall falls off. Drop it
# to 720 for a talking-head corpus and halve the transfer.
VIDTHEQUE_INDEX_MAX_HEIGHT=1080

# Where the transcript comes from.
#   prefer_whisperx (default) whisperX when the worker answers, YouTube
#                   auto-captions when it does not. Per-stage versioning makes
#                   "index with auto-caps now, upgrade later" a supported flow.
#   whisperx_only   never index a caption track; fail the video instead.
#   prefer_captions captions when they exist, whisperX only when they do not.
#   captions_only   the zero-GPU install path. Point WORKER_URL at nothing and
#                   the product still works, degraded: auto-captions carry
#                   per-word timings, so deep links stay precise. What they do
#                   not carry is punctuation, casing or correct proper nouns —
#                   which is most of what you search a talk corpus for.
VIDTHEQUE_STT_POLICY=prefer_whisperx

# Caption languages to consider, in order. At most two are ever used, and
# translated tracks are never enumerated: YouTube's subtitle endpoint is rate
# limited far harder than its player endpoint, and a single cold-IP run earned
# a 429 on its third timedtext request.
VIDTHEQUE_SUBTITLE_LANGS=en

# ---------------------------------------------------------------------------
# Indexing pipeline — yt-dlp manners
#
# yt-dlp's own `-t sleep` preset, as a floor. Conservative on purpose: indexing
# is not latency-sensitive, and hammering through a 429 is how a residential IP
# earns a longer block.
# ---------------------------------------------------------------------------

VIDTHEQUE_YTDLP_SLEEP_REQUESTS=0.75
VIDTHEQUE_YTDLP_SLEEP_INTERVAL=10
VIDTHEQUE_YTDLP_MAX_SLEEP_INTERVAL=20
VIDTHEQUE_YTDLP_SLEEP_SUBTITLES=5
# A randomised gap between *videos*, not just between downloads — the setting
# that makes an overnight channel backfill invisible. The actual wait is this to
# twice this. 0 disables it.
VIDTHEQUE_YTDLP_BETWEEN_VIDEOS_S=30
# Retries per extraction; a 429 backs off exponentially within one.
VIDTHEQUE_YTDLP_EXTRACTOR_RETRIES=3
# Force a specific YouTube player client. Empty uses yt-dlp's default set, which
# currently includes two clients needing no PO token. A config knob for the day
# YouTube tightens, not a day-one thing.
VIDTHEQUE_YTDLP_PLAYER_CLIENT=
# Path to a cookies.txt. Unlocks members-only and age-gated content, changes the
# default client set, and is the fastest route to an account action on an
# automated downloader. vidtheque is a personal-corpus tool, not an archiver.
VIDTHEQUE_YTDLP_COOKIEFILE=
# Run the bundled Deno JS runtime JIT-less. Slower, but this box executes
# YouTube's JavaScript next to your MCP server; cheap insurance.
VIDTHEQUE_YTDLP_JITLESS=1

# ---------------------------------------------------------------------------
# Indexing pipeline — keyframes
# ---------------------------------------------------------------------------

# screencast | talking_head. `screencast` drops the hue and saturation channels
# from PySceneDetect's frame score and adds the Canny edge delta. IDE and slide
# content is near-greyscale, so those two channels are structurally zero and a
# full slide change scores (0+0+60)/3 = 20 against a default threshold of 27 —
# the cut is missed. `talking_head` uses the adaptive detector instead.
VIDTHEQUE_KEYFRAME_DETECTOR=screencast
# Keyframes are downscaled to this width before writing. 960 roughly halves the
# JPEG directory; below that, small on-screen text stops surviving OCR.
VIDTHEQUE_KEYFRAME_MAX_WIDTH=1280
VIDTHEQUE_KEYFRAME_JPEG_QUALITY=92
# Hard cap per video. Over it, shots are thinned uniformly — not by length,
# which would delete exactly the fast slide builds this corpus is about.
VIDTHEQUE_MAX_KEYFRAMES=600
# Shots longer than this are subdivided, so an unedited screen recording (one
# scene for the whole video) still yields keyframes.
VIDTHEQUE_MAX_SHOT_SECONDS=25
# Frames sampled per shot; the sharpest by Laplacian variance wins. Odd, so one
# lands mid-shot.
VIDTHEQUE_SHOT_CANDIDATES=9
# Hamming distance, out of 256 bits, below which two frames are the same screen.
# ~24 (9.4%) absorbs JPEG noise, a blinking cursor and a moving pointer while
# separating a genuine slide change. Screencasts with heavy static chrome want
# it lower; full-bleed video wants it higher. Duplicates are kept as rows with
# `dup_of` set — they are provenance, and they cost no OCR and no vector.
VIDTHEQUE_PHASH_THRESHOLD=24

# Threads for the keyframe stage's *second* pass — the one that seeks
# VIDTHEQUE_SHOT_CANDIDATES times per shot, scores each frame and writes the
# JPEG. Measured across a 75-video corpus, that pass is ~34% of the stage and
# ~115 ms of every candidate seek is OpenCV decoding forward from the preceding
# H.264 keyframe, single-threaded (research/pipeline-perf-2026-08-09.md §2-§3).
# Shots are independent and the seeks are absolute, so N threads with one
# VideoCapture each produce the *same* frames — the frames are still committed
# one at a time, in shot order, so ordinals, filenames and the first-wins dedup
# never move. This is not in the stage's model_key for that reason: changing it
# does not invalidate anything already indexed.
#
# 1 is the historical path exactly (no pool at all). 4 on a 10-core box is
# ~1.3x on the whole stage; past that the detection pass, which this does not
# touch, is all that is left. Do not exceed your core count, and leave room for
# whatever else the box is doing.
VIDTHEQUE_KEYFRAME_EXTRACT_WORKERS=1
# cv2.CAP_PROP_N_THREADS for those captures: frame-threaded decode inside each
# seek, the same lever `threading_mode="AUTO"` is for the detection pass (which
# was worth 1.45x there). 0 leaves OpenCV's default alone. It multiplies with
# the setting above — 4 workers x 4 threads is 16 threads on a 10-core box —
# so raise one or the other, not both. Advisory: backends other than FFmpeg
# ignore it silently.
VIDTHEQUE_KEYFRAME_DECODE_THREADS=0

# ---------------------------------------------------------------------------
# Indexing pipeline — worker calls
# ---------------------------------------------------------------------------

# Batch sizes. Bigger batches amortise the worker's per-request overhead;
# smaller ones give finer job progress and lose less work to a 503.
VIDTHEQUE_OCR_BATCH=8
VIDTHEQUE_EMBED_BATCH=32
VIDTHEQUE_FRAME_EMBED_BATCH=8
# Lines below this confidence are dropped before they reach the index.
VIDTHEQUE_OCR_MIN_CONFIDENCE=0.5
# NaFlex patch budget for frame embeddings. Empty uses the worker's own default
# (IMAGE_EMBED_MAX_PATCHES); the model was trained on 128/256/576/784/1024.
VIDTHEQUE_FRAME_EMBED_MAX_PATCHES=

# Per-request budget for OCR and embedding calls, in seconds.
VIDTHEQUE_WORKER_TIMEOUT_S=120
# Transcription gets its own, much longer budget: it is minutes of GPU work on
# an hour of audio, behind a queue that may be serving something else.
VIDTHEQUE_STT_TIMEOUT_S=1800
# The worker answers 503 with a Retry-After under VRAM pressure. An indexing job
# waits it out — the difference between a job that survives a shared GPU and one
# that fails whenever llama.cpp is holding the card.
VIDTHEQUE_WORKER_RETRIES=3
VIDTHEQUE_WORKER_RETRY_MAX_WAIT_S=120
# ...and it waits it out on a wall clock, not on a request count. `RETRIES`
# bounds *requests* (a worker that keeps dropping the connection is not about to
# start answering); backpressure is the worker saying "not yet", so it is
# bounded by this instead. Four requests at Retry-After 30 is 90 seconds, which
# is not the "an indexing job has hours" the loop was written for.
VIDTHEQUE_WORKER_RETRY_TOTAL_S=1800
# STT_TIMEOUT_S is a *floor*. A recording longer than it gets this many seconds
# of budget per second of audio, because a flat number covers a conference talk
# and not a three-hour stream — and a read timeout is no longer replayed (the
# worker may still be transcribing), so the budget has to be right rather than
# recoverable. 2.0 is generous on a GPU and adequate on CPU.
VIDTHEQUE_STT_REALTIME_FACTOR=2.0

# ---------------------------------------------------------------------------
# Indexing pipeline — crash recovery
# ---------------------------------------------------------------------------

# How long a job's claim may go without a heartbeat before the next pass decides
# the process holding it is gone: the job is requeued and the stage it died in
# is reset, so indexing resumes per stage (index-schema §1.9). The runner
# heartbeats every 30 s and on every progress report, so a live job is never
# this quiet. Lower it and a slow stage risks being reclaimed out from under
# itself; raise it and a killed process's video stays claimed for longer.
VIDTHEQUE_STALE_CLAIM_S=300

# How long a job sits out after one of its items was rate-limited by the source,
# when the source did not say how long itself (a `Retry-After` always wins). The
# job goes back on the queue with `not_before` set, so the runner picks up other
# work instead of handing the same 429 straight back to the same URL. YouTube's
# 429s clear in minutes; retrying in milliseconds is how a soft block becomes a
# long one (research §5.5).
VIDTHEQUE_RATE_LIMIT_BACKOFF_S=300

# ===========================================================================
# The public demo — read-only mode, the /api facade, the page, rate limits.
#
# Contract: docs/design/demo-site.md. One flag turns all four on together; it is
# a deployment *mode*, resolved once at app construction, like VIDTHEQUE_AUTH.
# ===========================================================================

# 1 = read-only public deployment:
#   * the write tools (index-video, tag-video) are NEVER registered — absent
#     from tools/list, not present-and-refusing;
#   * /api/search, /api/videos, /api/meta and /api/ask are served;
#   * / serves the demo page;
#   * /api/* and /frames/* are rate limited per IP.
# The read surface (seven tools, three resources, /mcp, /frames, /healthz) is
# unchanged, so the public instance is a real MCP server anyone can add to their
# own agent — which is the point of the demo.
#
# The intended production combination is VIDTHEQUE_AUTH=none + this flag + an
# https PUBLIC_URL + VIDTHEQUE_PUBLIC_HOSTNAME. The flag is orthogonal to the
# auth mode: token/oauth plus this flag is a credentialed read-only server.
VIDTHEQUE_PUBLIC_READONLY=0

# ===========================================================================
# The management dashboard — /dashboard, the browsable index
#
# Contract: docs/design/dashboard.md. A route group in this same process, not a
# second service: all state lives here, SQLite wants one writer, and the job
# runner is an asyncio task in this app.
# ===========================================================================

# 1 = serve /dashboard: the corpus overview, the videos table, the video detail
# page (provenance, scene timeline, keyframe strip, transcript and OCR
# browsers), the jobs view (what the pipeline is waiting on, and for how long),
# and /dashboard/api/* — the same JSON handlers /api/* uses, under wider owner
# clamps. That last part is also how a *private* deployment gets a JSON facade
# without turning the public demo on.
#
# With VIDTHEQUE_PUBLIC_READONLY=1 the jobs view keeps its states, codes, counts
# and clocks and drops source URLs and error text — a visitor sees what indexing
# a video costs in time, not what is in the operator's yt-dlp configuration.
#
# Default-on is safe because the write side is never registered when
# VIDTHEQUE_AUTH=none: an unauthenticated instance behind a tunnel with a live
# "index this URL" button is remote-yt-dlp-as-a-service. With token/oauth the
# read views need the same credential /frames/* does — the bearer token or the
# owner's session cookie.
VIDTHEQUE_DASHBOARD=1

# ---------------------------------------------------------------------------
# The write side — /dashboard/login, the index form, re-index and tag
#
# It is registered only when BOTH are true: VIDTHEQUE_PUBLIC_READONLY=0 and
# VIDTHEQUE_AUTH is token or oauth. Otherwise the routes and the login page do
# not exist at all — 404, not 403 — because a route that exists and refuses is
# a route somebody probes. Nothing below turns it on; the two settings above do.
# ---------------------------------------------------------------------------

# Peer networks allowed to write **without** a credential, comma separated
# (e.g. 10.0.0.0/8,192.168.0.0/16). Empty = off, and that is the shipped
# default: RFC1918-on-by-default would silently grant indexing to everyone on
# whatever network this box happens to be on.
#
# Matched against the **socket peer address only** — never
# VIDTHEQUE_TRUSTED_IP_HEADER. That header is trust-on-configuration, which is
# right for rate-limit bucketing and disqualifying for authorization: any
# client can send it, so a header-based allowlist is an allowlist of everybody.
# A loopback-only default would not help either, because under compose the peer
# is the bridge gateway rather than 127.0.0.1 — hence a var that ships empty
# and a one-line entry here for a home lab.
VIDTHEQUE_DASHBOARD_TRUSTED_CIDRS=

# How long a browser session lasts, in seconds. Default 43200 (12 h). This is
# the vidtheque_session cookie and its login_sessions row — one cookie, one
# table, one lifetime, whether it was minted by /dashboard/login or by the
# OAuth consent screen. (Before phase 3 this number was hard-coded in
# config.py while every other tunable had a reader.)
VIDTHEQUE_DASHBOARD_SESSION_TTL_S=43200

# The secret the login page exchanges for that cookie is one you have already
# set above: VIDTHEQUE_PASSWORD when it is set (required in oauth mode), and in
# token mode VIDTHEQUE_TOKEN also works, so a token-only deployment still has a
# browser path in. Scripts should skip the page entirely and send
# `Authorization: Bearer $VIDTHEQUE_TOKEN` on the POST.

# /dashboard/* — per IP, per minute. Loose: this is a human clicking, and one
# page load is one request (its thumbnails are /frames/* and are charged there,
# or not at all in a private deployment). It exists so a bot walking
# /dashboard/api/videos cannot become a denial of service, which is the same
# reason the public buckets exist. This is the one limiter bucket that is
# installed in **every** mode, not only public mode.
#
# The floor for this number is the jobs view: an open tab polls every 2 s while
# a job is running and stops when none is, so each one costs 30/min. 120 leaves
# room for a human clicking beside two of them; below ~60 a watched job page
# starts refusing its own ticks.
#
# /dashboard/login is NOT on this bucket. It has its own, fixed at 10/min per
# IP, because it is the one path here where a request is a guess at a secret —
# and a login rate a deployment can raise is a login rate somebody raises.
VIDTHEQUE_RATE_DASHBOARD_PER_MIN=120

# ---------------------------------------------------------------------------
# Ask mode (POST /api/ask) — a server-side agent loop over OpenRouter
#
# An empty key means the mode is off: /api/meta reports ask_enabled=false and
# the page hides the Ask toggle rather than offering a button that 503s. Search
# always works; ask mode is the part that is allowed to be unavailable.
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=

# Verified against https://openrouter.ai/api/v1/models on 2026-08-08: there is
# no `deepseek/*:free` model on OpenRouter any more — that whole family is paid.
# Of the fourteen `:free` ids that day, this is the pick: it advertises `tools`
# (the entire mode is function calling), carries 131k of context, and the id has
# been stable for a year. Free, tool-capable alternatives:
#   nvidia/nemotron-3-super-120b-a12b:free   (bigger, 262k)
#   google/gemma-4-31b-it:free
#   inclusionai/ling-3.0-tiny:free           (fastest)
# Any OpenAI-compatible model id the endpoint serves works here.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# The OpenAI-compatible base URL. Point it at another gateway (or a local
# llama.cpp) and ask mode follows: the client speaks nothing OpenRouter-specific
# beyond two attribution headers.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tool rounds before the loop stops calling tools and is forced to answer. Each
# round is one upstream completion plus up to 6 internal tool calls, so this is
# the main cost knob.
VIDTHEQUE_ASK_MAX_ROUNDS=4
# Wall-clock budget for the whole loop, in seconds. A free-tier queue that
# stalls becomes a clean 503, not a held connection.
VIDTHEQUE_ASK_TIMEOUT_S=90

# ---------------------------------------------------------------------------
# Rate limits (public mode only). Token buckets, per IP, in memory.
#
# In-memory and single-process on purpose: there is one uvicorn process holding
# one SQLite writer, so there is no replica for a shared counter to be shared
# with. The visible consequence is that a redeploy resets the daily ask budget.
# Capacity doubles as the burst allowance; refill is continuous, so Retry-After
# is the real answer to "when will this work", not the top of the minute.
# ---------------------------------------------------------------------------

# /api/search, /api/videos, /api/meta — per IP.
VIDTHEQUE_RATE_SEARCH_PER_MIN=30
# /api/ask — per IP.
VIDTHEQUE_RATE_ASK_PER_MIN=5
# /api/ask — whole server, refilled continuously over 24h, so the budget
# trickles back through the day instead of unblocking at UTC midnight. The
# free-model budget guard: deliberately conservative rather than measured.
VIDTHEQUE_RATE_ASK_PER_DAY=50
# /frames/* — per IP. Loose on purpose: one screen of results is ~10 thumbnails,
# so this exists to stop a scraper walking the keyframe directory, not to police
# normal browsing.
VIDTHEQUE_RATE_FRAMES_PER_MIN=120
# Bucket-table ceiling. Over it, full buckets are dropped first — a full bucket
# is indistinguishable from a client that was never seen.
VIDTHEQUE_RATE_MAX_KEYS=10000

# Header the limiter trusts for the client IP, falling back to the socket
# address. THIS IS TRUST-ON-CONFIGURATION: any client can send
# `CF-Connecting-IP: 1.2.3.4` and get a fresh bucket. Behind Cloudflare that is
# impossible (the edge overwrites it), which is the deployment this default is
# written for. Exposed directly to the internet, set this **empty** and only the
# socket address is used.
#
# The precondition, stated plainly because it is a deployment step and not a
# code one: BEHIND A TUNNEL, KEEP THE DEFAULT *AND* MAKE THE TUNNEL THE ONLY
# WAY IN. Nothing in the limiter checks that a request arrived through
# cloudflared, so an origin that is also reachable directly has no per-IP limit
# at all — only the server-wide ask_global bucket survives. And do not "play it
# safe" by emptying it behind a tunnel: cloudflared connects from loopback, so
# every visitor would then share one bucket and the demo rate-limits itself into
# uselessness. Bind to loopback, keep the header. docs/deploy-public.md §4.
VIDTHEQUE_TRUSTED_IP_HEADER=CF-Connecting-IP
