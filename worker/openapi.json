  "info": {
    "description": "Stateless inference worker for vidtheque: speech-to-text with word timestamps,\ntext embeddings, frame embeddings, and on-screen-text OCR. One lifecycle manager\nowns the GPU \u2014 requests queue rather than compete. The transcription and text\nembedding endpoints follow OpenAI's shapes so a GPU-less deployment can swap in a\nhosted provider. Text and frame embeddings are separate vector spaces with\nseparate models and separate endpoints; they are never interchangeable. A\nnatural-language query reaches the frame space through the frame model's own\ntext tower, on /v1/embeddings/frame-query \u2014 never through /v1/embeddings.\n",
    "title": "vidtheque-worker",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
