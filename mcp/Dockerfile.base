# Trixie ships SQLite 3.46.1. Bookworm's 3.40.1 cannot run the ordered
# aggregates in migration 0003. (Field report, 2026-08-12.)
FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VIDTHEQUE_DATA_DIR=/data \
    PATH=/app/.venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY mcp/pyproject.toml mcp/
COPY worker/pyproject.toml worker/
COPY scripts/image_inputs.sh scripts/image_inputs.sh

# The export contains hashes for every supported wheel, including both MCP
# architectures, so installation rejects artifacts absent from the lock.
# Removing uv's cache in the same layer avoids shipping a second copy of the
# environment when UV_LINK_MODE is `copy`.
RUN uv venv --python 3.12 \
    && scripts/image_inputs.sh mcp > /tmp/requirements.txt \
    && uv pip install --require-hashes --requirements /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    && rm -rf /root/.cache/uv

# The internet-facing process runs yt-dlp and ffmpeg on remote input. It writes
# only /data; /app remains root-owned. (2026-08-10 audit, F-28.)
RUN groupadd --system --gid 10001 vidtheque \
    && useradd --system --uid 10001 --gid vidtheque --no-create-home vidtheque \
    && mkdir -p /data \
    && chown vidtheque:vidtheque /data
USER vidtheque:vidtheque
