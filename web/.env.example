# web/ — the Next.js front end. Copy to .env.local and fill in.
# deploy/.env.example is the document of record for every variable in the
# repo; these three are reproduced from its web/ section.

# The vidtheque instance this front end reads, over its public /api/* facade.
VIDTHEQUE_API_URL=https://vidtheque.example.com

# Header the visitor's address is forwarded under on the reads this server
# makes for a page — search, videos, meta. Must equal
# VIDTHEQUE_TRUSTED_IP_HEADER on the instance above, or every visitor shares
# one rate-limit bucket. Defaults to CF-Connecting-IP when unset. The browser's
# own requests (`/api/ask` and every frame) reach Python directly and carry the
# visitor's address without help.
VIDTHEQUE_CLIENT_IP_HEADER=CF-Connecting-IP

# `pnpm dev` only, and nothing to a built front end: the hosts besides
# `localhost` that the dev server accepts requests from, comma separated.
# Unset means 127.0.0.1 and nothing else. Set it when the dev server runs on a
# box reached over the LAN — that box's own address, or its pages load in the
# browser and never hydrate. One machine's address, so it stays out of the repo
# and lives here in .env.local.
# VIDTHEQUE_DEV_ORIGINS=127.0.0.1,192.168.0.10
