# web/ — the Next.js front end. Copy to .env.local and fill in.
# deploy/.env.example is the document of record for every variable in the
# repo; these two are reproduced from its web/ section.

# The vidtheque instance this front end reads, over its public /api/* facade.
VIDTHEQUE_API_URL=https://vidtheque.example.com

# Header the visitor's address is forwarded under. Must equal
# VIDTHEQUE_TRUSTED_IP_HEADER on the instance above, or every visitor shares
# one rate-limit bucket. Defaults to CF-Connecting-IP when unset.
VIDTHEQUE_CLIENT_IP_HEADER=CF-Connecting-IP
